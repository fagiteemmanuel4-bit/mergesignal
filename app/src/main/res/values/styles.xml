<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PromptNotes" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B85C3B</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F8F6F2</item>
        <item name="android:navigationBarColor">#F8F6F2</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.PromptNotes.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8F6F2</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_prompt_notes</item>
        <item name="postSplashScreenTheme">@style/Theme.PromptNotes</item>
    </style>
</resources>
